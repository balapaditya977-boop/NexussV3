async function toggleFollowArtist(){
  const btn=$("followBtn"); const following = btn.dataset.following==="true";
  try{
    await api("/me/following?type=artist&ids="+currentArtistId, { method: following?"DELETE":"PUT" });
    btn.dataset.following=(!following).toString();
    btn.textContent = !following ? "Mengikuti" : "Ikuti";
  }catch(e){ showToast("Gagal memperbarui status ikuti."); }
}

// ---------- Like ----------
function heartSvg(liked,id){
  return '<svg class="heart '+(liked?"liked":"")+'" data-id="'+id+'" data-liked="'+liked+'" viewBox="0 0 24 24" onclick="event.stopPropagation(); toggleLike(this)" fill="'+(liked?"var(--accent)":"none")+'" stroke="var(--accent)" stroke-width="1.8"><path d="M12 21s-7.5-4.6-10-9.3C.5 8 2 4.5 5.5 4c2-.3 3.8.7 4.9 2.3C11.5 4.7 13.3 3.7 15.3 4c3.5.5 5 4 3.5 7.7C19.5 16.4 12 21 12 21z"/></svg>';
}
async function checkLiked(ids){ if(!ids.length) return []; try{ return await api("/me/tracks/contains?ids="+ids.join(",")); }catch(e){ return ids.map(()=>false); } }
async function syncHearts(selector, ids){
  if(!ids.length) return;
  const liked = await checkLiked(ids);
  document.querySelectorAll(selector).forEach((el,i)=>{ if(liked[i]){ el.dataset.liked="true"; el.classList.add("liked"); el.setAttribute("fill","var(--accent)"); } });
}
async function toggleLike(el){
  const id=el.dataset.id; if(!id) return;
  const liked = el.dataset.liked==="true";
  try{
    await api("/me/tracks?ids="+id, { method: liked?"DELETE":"PUT" });
    el.dataset.liked=(!liked).toString(); el.classList.toggle("liked");
    el.setAttribute("fill", !liked?"var(--accent)":"none");
  }catch(e){ showToast("Gagal memperbarui lagu disukai."); }
}

// ---------- Shuffle / repeat / volume ----------
let shuffleOn=false, repeatMode="off";
async function toggleShuffle(){
  shuffleOn=!shuffleOn; $("shuffleIcon").classList.toggle("active", shuffleOn);
  try{ await api("/me/player/shuffle?state="+shuffleOn, {method:"PUT"}); }catch(e){}
}
async function toggleRepeat(){
  const order=["off","context","track"]; repeatMode=order[(order.indexOf(repeatMode)+1)%3];
  $("repeatIcon").classList.toggle("active", repeatMode!=="off");
  try{ await api("/me/player/repeat?state="+repeatMode, {method:"PUT"}); }catch(e){}
}
let volDebounce;
function setVolume(v){ clearTimeout(volDebounce); volDebounce=setTimeout(()=>{ api("/me/player/volume?volume_percent="+v,{method:"PUT"}).catch(()=>{}); },300); }

// ---------- Queue ----------
async function toggleQueue(){
  const panel=$("queuePanel");
  if (panel.classList.contains("show")){ panel.classList.remove("show"); return; }
  panel.classList.add("show");
  $("queueList").innerHTML = '<div class="skeleton" style="height:50px;margin-bottom:8px;"></div>'.repeat(4);
  try{
    const data = await api("/me/player/queue");
    const list = (data.queue||[]).slice(0,15);
    if (!list.length){ $("queueList").innerHTML = '<div class="empty-state">Antrian kosong.</div>'; return; }
    $("queueList").innerHTML = list.map((t,i)=>{
      const img=(t.album.images[2]||t.album.images[0]||{}).url||"";
      return '<div class="list-item pop-in" style="animation-delay:'+(i*25)+'ms"><img src="'+img+'"><div class="meta"><b>'+esc(t.name)+'</b><span>'+esc(t.artists.map(a=>a.name).join(", "))+'</span></div></div>';
    }).join("");
  }catch(e){ $("queueList").innerHTML = '<div class="empty-state">Tidak bisa memuat antrian.</div>'; }
}

// ---------- Create playlist ----------
function openCreatePlaylistModal(){ $("newPlaylistName").value=""; $("modalOverlay").classList.add("show"); }
function closeModal(){ $("modalOverlay").classList.remove("show"); }
async function createPlaylist(){
  const name = $("newPlaylistName").value.trim();
  if (!name) return;
  try{
    const me = await api("/me");
    await api("/users/"+me.id+"/playlists", { method:"POST", body: JSON.stringify({ name, public:false }) });
    closeModal(); showToast("Playlist \""+name+"\" dibuat."); loadLibrary();
  }catch(e){ showToast("Gagal membuat playlist."); }
}

// ---------- Player ----------
let lastTrackId=null;
async function pollCurrentlyPlaying(){
  try{
    const data = await api("/me/player");
    if (!data || !data.item){ $("playerBar").classList.remove("show"); return; }
    currentDeviceId = data.device ? data.device.id : null;
    const t=data.item;
    const img=(t.album.images[2]||t.album.images[0]||{}).url||"";
    $("pbImg").src=img; $("fpImg").src=(t.album.images[0]||{}).url||"";
    $("pbTitle").textContent=t.name; $("fpTitle").textContent=t.name;
    $("pbArtist").textContent=t.artists.map(a=>a.name).join(", ");
    $("fpArtist").textContent=t.artists.map(a=>a.name).join(", ");
    setPlayIcon(data.is_playing);
    $("fpImg").classList.toggle("spin", !!data.is_playing);
    const pct = Math.min(100, (data.progress_ms/t.duration_ms)*100);
    $("fpProgress").style.width = pct+"%";
    $("playerBar").classList.add("show");

    if (typeof data.shuffle_state==="boolean"){ shuffleOn=data.shuffle_state; $("shuffleIcon").classList.toggle("active", shuffleOn); }
    if (data.repeat_state){ repeatMode=data.repeat_state; $("repeatIcon").classList.toggle("active", repeatMode!=="off"); }
    if (data.device && typeof data.device.volume_percent==="number" && document.activeElement!==$("volumeSlider")){ $("volumeSlider").value=data.device.volume_percent; }
    if (t.id!==lastTrackId){
      lastTrackId=t.id;
      $("fpHeart").dataset.id=t.id; $("fpHeart").dataset.liked="false";
      $("fpHeart").setAttribute("fill","none"); $("fpHeart").classList.remove("liked");
      syncHearts("#fpHeart",[t.id]);
    }
  }catch(e){ /* ignore transient errors */ }
}
let pollTimer = setInterval(pollCurrentlyPlaying, 15000);
document.addEventListener("visibilitychange", ()=>{
  clearInterval(pollTimer);
  if (!document.hidden){ pollCurrentlyPlaying(); pollTimer=setInterval(pollCurrentlyPlaying, 15000); }
});

function setPlayIcon(isPlaying){
  const d = isPlaying ? "M6 5h4v14H6zm8 0h4v14h-4z" : "M8 5v14l11-7z";
  $("pbPlayPath").setAttribute("d", d); $("fpPlayPath").setAttribute("d", d);
}
async function togglePlay(){
  try{
    const data = await api("/me/player");
    const playing = data && data.is_playing;
    await api("/me/player/"+(playing?"pause":"play"), { method:"PUT" });
    setPlayIcon(!playing);
    setTimeout(pollCurrentlyPlaying, 600);
  }catch(e){ showToast("Tidak bisa kontrol pemutaran. Pastikan Spotify Premium & ada perangkat aktif."); }
}
async function nextTrack(){ try{ await api("/me/player/next",{method:"POST"}); setTimeout(pollCurrentlyPlaying,600); }catch(e){} }
async function prevTrack(){ try{ await api("/me/player/previous",{method:"POST"}); setTimeout(pollCurrentlyPlaying,600); }catch(e){} }
async function playUri(uri){
  try{
    await api("/me/player/play", { method:"PUT", body:JSON.stringify({ uris:[uri] }) });
    setTimeout(pollCurrentlyPlaying,600);
  }catch(e){ showToast("Tidak bisa memutar lagu. Pastikan Spotify Premium & buka Spotify di salah satu perangkatmu dulu."); }
}
function seekTo(e){
  const bar = $("fpProgressBar"); const rect = bar.getBoundingClientRect();
  const pct = Math.min(1, Math.max(0, (e.clientX-rect.left)/rect.width));
  $("fpProgress").style.width = (pct*100)+"%";
}

function openFullPlayer(){ $("fullPlayer").classList.add("show"); }
function closeFullPlayer(){ $("fullPlayer").classList.remove("show"); $("queuePanel").classList.remove("show"); }

// ---------- Boot ----------
async function boot(){
  const params = new URLSearchParams(location.search);
  const code = params.get("code"); const err = params.get("error");
  if (err){ initSetupScreen(); showScreen("screen-setup"); showSetupError("Login dibatalkan atau ditolak: "+err); history.replaceState({},"",location.pathname); return; }
  if (code){
    showScreen("screen-loading");
    try{ await exchangeCodeForToken(code); history.replaceState({},"",location.pathname); startApp(); }
    catch(e){ initSetupScreen(); showScreen("screen-setup"); showSetupError(e.message); }
    return;
  }
  const hasToken = localStorage.getItem(LS.refreshToken) || localStorage.getItem(LS.accessToken);
  if (hasToken) startApp(); else showScreen("screen-welcome");
}
function startApp(){ $("tabbar").style.display="flex"; showTab("home"); }
boot();
</script>
