<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nexus</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#150f1a; --bg2:#1c1420; --card:#241a29; --card2:#2b1f31;
    --text:#f6ede3; --sub:#a89aad; --line:#32263a;
    --accent:#e2963f; --accent-ink:#241405; --rust:#c75a3a;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    font-family:'Work Sans',-apple-system,sans-serif;
    background:
      radial-gradient(900px 500px at 50% -10%, #2a1d33 0%, transparent 60%),
      var(--bg);
    background-size:200% 200%;
    animation:bgDrift 20s ease-in-out infinite;
    color:var(--text); min-height:100vh;
    display:flex; justify-content:center;
    overscroll-behavior:none;
  }
  @keyframes bgDrift{ 0%,100%{ background-position:50% 0%; } 50%{ background-position:50% 30%; } }
  h1,h2,.btn,.wordmark{ font-family:'Oswald',sans-serif; }
  #app{ width:100%; max-width:480px; min-height:100vh; display:flex; flex-direction:column; position:relative; }

  .wordmark{ display:flex; align-items:center; gap:9px; font-weight:600; font-size:21px; letter-spacing:1.5px; text-transform:uppercase; color:var(--text); }
  .wordmark .groove{ width:17px; height:17px; border-radius:50%; background:linear-gradient(135deg,#ffd9a0,var(--rust)); position:relative; flex:0 0 auto; }
  .wordmark .groove::after{ content:""; position:absolute; inset:5px; border-radius:50%; background:var(--bg); }

  header.topbar{ padding:20px 20px 14px; position:sticky; top:0; z-index:5; display:flex; align-items:center; justify-content:space-between;
    background:rgba(26,18,31,.55); backdrop-filter:blur(18px) saturate(170%); -webkit-backdrop-filter:blur(18px) saturate(170%); }
  header.topbar::after{ content:""; position:absolute; left:20px; right:20px; bottom:-1px; height:2px; background:linear-gradient(90deg, var(--accent), transparent 70%); }

  .screen{ flex:1; padding:0 18px 110px; overflow-y:auto; display:none; opacity:0; transform:translateY(10px); }
  .screen.active{ display:block; }
  .screen.active.fade-in{ transition:opacity .32s cubic-bezier(.3,0,.2,1), transform .32s cubic-bezier(.3,0,.2,1); opacity:1; transform:translateY(0); }

  h1.greet{ font-size:27px; font-weight:600; letter-spacing:.3px; margin:18px 0 16px; }
  h2.section{ font-size:16px; font-weight:600; letter-spacing:.3px; margin:22px 0 12px; display:flex; align-items:center; justify-content:space-between; }

  @keyframes popIn{ from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);} }
  .pop-in{ animation:popIn .4s cubic-bezier(.2,.8,.2,1) both; }

  .btn, .pillcard, .tile img, .list-item, nav.tabbar button, .fullplayer .controls svg, .player-bar .ctrl svg, .chip, .genre-chip, .tab-chip{
    transition:transform .18s ease, filter .18s ease, background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  .btn:active{ transform:scale(.97); filter:brightness(.95); }
  .pillcard:active, .list-item:active{ transform:scale(.98); background:var(--card2); }
  .tile:active img{ transform:scale(.96); }
  .fullplayer .controls svg:active, .player-bar .ctrl svg:active{ transform:scale(.85); }
  nav.tabbar button svg{ transition:transform .2s ease; }
  nav.tabbar button.active svg{ transform:translateY(-2px); }

  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:22px; }
  .pillcard{ background:rgba(255,255,255,.06); backdrop-filter:blur(14px) saturate(160%); -webkit-backdrop-filter:blur(14px) saturate(160%);
    border:1px solid rgba(255,255,255,.13); border-radius:999px; display:flex; align-items:center; gap:10px; padding:6px 14px 6px 6px; cursor:pointer; }
  .pillcard img{ width:40px; height:40px; border-radius:50%; object-fit:cover; background:#3a2d40; border:2px solid var(--accent); }
  .pillcard span{ font-size:13px; font-weight:500; line-height:1.2; }

  .row-scroll{ display:flex; gap:16px; overflow-x:auto; padding-bottom:6px; }
  .tile{ width:128px; flex:0 0 auto; cursor:pointer; position:relative; }
  .tile img{ width:128px; height:128px; border-radius:6px; object-fit:cover; background:#3a2d40; border:1px solid var(--line); }
  .tile p{ font-size:13px; font-weight:600; margin-top:8px; }
  .tile p.sub{ font-size:12px; color:var(--sub); font-weight:400; margin-top:1px; }
  .tile .heart{ position:absolute; top:6px; right:6px; width:22px; height:22px; background:rgba(14,10,16,.55); border-radius:50%; padding:4px; backdrop-filter:blur(6px); }

  .list-item{ display:flex; align-items:center; gap:12px; padding:11px 0; border-bottom:1px solid var(--line); cursor:pointer; }
  .list-item img{ width:46px; height:46px; border-radius:5px; object-fit:cover; background:#3a2d40; }
  .list-item .meta{ flex:1; min-width:0; }
  .list-item .meta b{ display:block; font-size:14px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .list-item .meta span{ font-size:12px; color:var(--sub); display:block; margin-top:2px; }
  .heart{ width:19px; height:19px; cursor:pointer; flex:0 0 auto; }

  input.search, .field input{ width:100%; padding:13px 16px; border-radius:8px; border:1px solid rgba(255,255,255,.14); background:rgba(255,255,255,.055);
    backdrop-filter:blur(14px) saturate(160%); -webkit-backdrop-filter:blur(14px) saturate(160%); color:var(--text); font-size:15px; font-family:'Work Sans',sans-serif; }
  input.search{ margin:12px 0 16px; }
  input.search:focus, .field input:focus{ outline:none; border-color:var(--accent); }

  .search-tabs, .genre-row{ display:flex; gap:8px; margin-bottom:4px; overflow-x:auto; padding-bottom:2px; }
  .tab-chip, .genre-chip{ background:rgba(255,255,255,.055); border:1px solid var(--line); color:var(--sub); padding:7px 15px; border-radius:20px; font-size:13px; cursor:pointer; font-family:'Work Sans',sans-serif; white-space:nowrap; flex:0 0 auto; }
  .tab-chip.active{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); font-weight:600; }
  .genre-chip:active{ transform:scale(.95); }

  .btn{ background:linear-gradient(135deg, #f0ad5c 0%, var(--accent) 45%, var(--rust) 100%); color:var(--accent-ink); border:none; border-radius:8px;
    padding:14px 22px; font-size:14px; font-weight:600; letter-spacing:.5px; text-transform:uppercase; cursor:pointer; width:100%; }
  .btn.secondary{ background:var(--card); color:var(--text); }
  .btn.ghost{ background:rgba(255,255,255,.05); backdrop-filter:blur(14px) saturate(160%); -webkit-backdrop-filter:blur(14px) saturate(160%); border:1px solid var(--line); color:var(--text); text-transform:none; letter-spacing:0; }

  .field{ margin-bottom:14px; text-align:left; }
  .field label{ font-size:12px; color:var(--sub); display:block; margin-bottom:6px; }
  .note{ font-size:12.5px; color:var(--sub); line-height:1.55; margin-top:10px; }
  .center-screen{ display:flex; flex-direction:column; justify-content:center; align-items:center; height:100%; text-align:center; padding:30px; gap:14px; }
  .logo-big{ font-size:30px; }
  .logo-big .groove{ width:20px; height:20px; }

  .hero-glow{ position:absolute; top:-120px; left:50%; transform:translateX(-50%); width:360px; height:360px; border-radius:50%;
    background:radial-gradient(circle at 35% 35%, #ffd9a0 0%, var(--accent) 35%, var(--rust) 65%, transparent 75%);
    filter:blur(50px); opacity:.55; pointer-events:none; animation:pulseGlow 5s ease-in-out infinite; }
  @keyframes pulseGlow{ 0%,100%{ opacity:.45; transform:translateX(-50%) scale(1); } 50%{ opacity:.65; transform:translateX(-50%) scale(1.08); } }

  .avatar-ring{ background:linear-gradient(135deg,#ffd9a0,var(--rust)); padding:3px; border-radius:50%; display:inline-flex; }
  .avatar-ring img{ border:3px solid var(--bg2); display:block; }

  nav.tabbar{ position:fixed; bottom:0; left:50%; transform:translateX(-50%); width:100%; max-width:480px;
    background:rgba(24,17,28,.6); backdrop-filter:blur(24px) saturate(170%); -webkit-backdrop-filter:blur(24px) saturate(170%);
    border-top:1px solid rgba(255,255,255,.08); display:flex; justify-content:space-around;
    padding:11px 0 calc(11px + env(safe-area-inset-bottom,0px)); z-index:10; }
  nav.tabbar button{ background:none; border:none; color:var(--sub); font-size:11px; font-family:'Work Sans',sans-serif; display:flex; flex-direction:column; align-items:center; gap:5px; cursor:pointer; }
  nav.tabbar button.active{ color:var(--accent); }
  nav.tabbar svg{ width:21px; height:21px; }

  .player-bar{ position:fixed; bottom:64px; left:50%; width:100%; max-width:480px;
    background:rgba(42,31,48,.55); backdrop-filter:blur(20px) saturate(170%); -webkit-backdrop-filter:blur(20px) saturate(170%);
    margin:0 10px; border-radius:10px; padding:9px 12px; display:flex; align-items:center; gap:11px; border:1px solid rgba(255,255,255,.14);
    box-shadow:0 6px 24px rgba(0,0,0,.5); opacity:0; pointer-events:none; transform:translateX(-50%) translateY(16px);
    transition:opacity .3s ease, transform .3s cubic-bezier(.3,0,.2,1); z-index:9; }
  .player-bar.show{ opacity:1; pointer-events:auto; transform:translateX(-50%) translateY(0); }
  .player-bar img{ width:38px; height:38px; border-radius:50%; object-fit:cover; background:#3a2d40; border:2px solid var(--accent); }
  .player-bar .info{ flex:1; min-width:0; }
  .player-bar .info b{ font-size:13px; font-weight:600; display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .player-bar .info span{ font-size:11px; color:var(--sub); }
  .player-bar .ctrl{ display:flex; gap:12px; align-items:center; }
  .player-bar .ctrl svg{ width:21px; height:21px; cursor:pointer; }

  .progress{ height:3px; background:var(--line); border-radius:2px; margin-top:8px; overflow:hidden; cursor:pointer; }
  .progress i{ display:block; height:100%; background:var(--accent); width:0%; }

  .fullplayer{ position:fixed; inset:0; background:radial-gradient(700px 400px at 50% 0%, #2a1d33 0%, transparent 60%), var(--bg);
    z-index:50; display:flex; flex-direction:column; padding:22px; max-width:480px; margin:0 auto;
    opacity:0; pointer-events:none; transform:translateY(24px); transition:opacity .32s ease, transform .32s cubic-bezier(.3,0,.2,1); overflow-y:auto; }
  .fullplayer.show{ opacity:1; pointer-events:auto; transform:translateY(0); }
  .fullplayer img#fpImg{ width:78%; aspect-ratio:1; border-radius:50%; object-fit:cover; background:#3a2d40; margin:34px auto; border:8px solid var(--card2);
    box-shadow:0 10px 40px rgba(0,0,0,.5); display:block; }
  .fullplayer img#fpImg.spin{ animation:spinVinyl 14s linear infinite; }
  @keyframes spinVinyl{ from{ transform:rotate(0deg); } to{ transform:rotate(360deg); } }
  .fullplayer h2{ font-size:21px; font-weight:600; text-align:center; }
  .fullplayer p{ color:var(--sub); margin-top:4px; text-align:center; font-size:14px; }
  .fullplayer .close{ font-size:24px; cursor:pointer; color:var(--sub); }
  .fullplayer .eyebrow{ font-size:11px; letter-spacing:1px; color:var(--sub); }
  .fullplayer .controls{ display:flex; justify-content:center; align-items:center; gap:34px; margin-top:34px; }
  .fullplayer .controls svg{ cursor:pointer; }
  .fullplayer .playbtn{ width:58px; height:58px; border-radius:50%; background:var(--accent); display:flex; align-items:center; justify-content:center; }
  .fullplayer .playbtn svg{ fill:var(--accent-ink); }
  .control-dock{ display:flex; justify-content:center; align-items:center; gap:34px; margin-top:34px; padding:16px 30px; border-radius:40px; width:fit-content; margin-left:auto; margin-right:auto; }
  .mini-ctrl{ width:20px; height:20px; cursor:pointer; color:var(--sub); }
  .mini-ctrl.active{ color:var(--accent); }
  input[type="range"]{ -webkit-appearance:none; height:4px; border-radius:2px; background:var(--line); }
  input[type="range"]::-webkit-slider-thumb{ -webkit-appearance:none; width:13px; height:13px; border-radius:50%; background:var(--accent); cursor:pointer; }

  .glass{ background:rgba(255,255,255,.055); backdrop-filter:blur(22px) saturate(170%); -webkit-backdrop-filter:blur(22px) saturate(170%);
    border:1px solid rgba(255,255,255,.14); box-shadow:inset 0 1px 0 rgba(255,255,255,.2), 0 12px 32px rgba(0,0,0,.35); position:relative; isolation:isolate; }
  .glass::before{ content:""; position:absolute; inset:0; border-radius:inherit; pointer-events:none; z-index:-1;
    background:linear-gradient(135deg, rgba(255,255,255,.16) 0%, rgba(255,255,255,0) 45%); }

  .queue-panel{ position:fixed; left:50%; bottom:0; transform:translateX(-50%) translateY(100%); width:100%; max-width:480px; max-height:65vh;
    border-radius:20px 20px 0 0; z-index:60; padding:18px 18px calc(18px + env(safe-area-inset-bottom,0px)); overflow-y:auto;
    transition:transform .32s cubic-bezier(.3,0,.2,1); }
  .queue-panel.show{ transform:translateX(-50%) translateY(0); }
  .modal-overlay{ position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:70; display:none; align-items:center; justify-content:center; padding:24px; }
  .modal-overlay.show{ display:flex; }
  .modal{ width:100%; max-width:380px; border-radius:16px; padding:22px; }
  .fab{ position:fixed; bottom:84px; right:calc(50% - 240px + 20px); width:52px; height:52px; border-radius:50%; background:linear-gradient(135deg,#f0ad5c,var(--rust));
    display:flex; align-items:center; justify-content:center; cursor:pointer; box-shadow:0 8px 24px rgba(0,0,0,.4); z-index:8; }
  @media (max-width:480px){ .fab{ right:20px; } }

  .skeleton{ background:linear-gradient(90deg, rgba(255,255,255,.04) 25%, rgba(255,255,255,.09) 37%, rgba(255,255,255,.04) 63%); background-size:400% 100%; animation:shimmer 1.4s ease-in-out infinite; border-radius:8px; }
  @keyframes shimmer{ 0%{ background-position:100% 0; } 100%{ background-position:-100% 0; } }
  .empty-state{ text-align:center; padding:40px 20px; color:var(--sub); font-size:14px; }
  .toast{ position:fixed; left:50%; bottom:150px; transform:translateX(-50%) translateY(20px); opacity:0;
    background:rgba(28,20,32,.9); backdrop-filter:blur(14px); color:var(--text); padding:11px 18px; border-radius:30px; font-size:13px;
    border:1px solid var(--line); z-index:80; pointer-events:none; transition:opacity .25s ease, transform .25s ease; max-width:85%; text-align:center; }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
  .error-box{ background:#3a1f26; color:#ffb199; padding:11px 13px; border-radius:6px; font-size:13px; margin-bottom:12px; border:1px solid #5a2a30; }
  img{ opacity:0; transition:opacity .35s ease; }
  img[src]:not([src=""]){ opacity:1; }
  a{ color:var(--accent); }
  .icon-btn{ background:none; border:none; color:var(--text); cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .eq{ display:flex; align-items:flex-end; gap:4px; height:28px; margin:20px auto; width:fit-content; }
  .eq i{ display:block; width:5px; background:var(--accent); border-radius:2px; animation:eqbar .9s ease-in-out infinite; }
  .eq i:nth-child(1){ height:40%; animation-delay:0s; } .eq i:nth-child(2){ height:100%; animation-delay:.15s; }
  .eq i:nth-child(3){ height:65%; animation-delay:.3s; } .eq i:nth-child(4){ height:85%; animation-delay:.45s; }
  @keyframes eqbar{ 0%,100%{ transform:scaleY(.4); } 50%{ transform:scaleY(1); } }
</style>
</head>
<body>
<div id="app">

  <!-- WELCOME -->
  <div id="screen-welcome" class="screen active">
    <div class="center-screen" style="padding-top:70px; position:relative;">
      <div class="hero-glow"></div>
      <div class="glass" style="padding:34px 26px; border-radius:26px; display:flex; flex-direction:column; align-items:center; gap:14px;">
        <div class="wordmark logo-big"><span class="groove"></span>Nexus</div>
        <p class="note" style="font-size:14px; max-width:260px;">Semua musik di Spotify kamu, dalam satu tampilan yang lebih tenang.</p>
        <button class="btn" style="margin-top:12px;" onclick="goToConnect()">Masuk dengan Spotify</button>
      </div>
      <p class="note">Login diproses langsung oleh Spotify. Nexus tidak pernah melihat kata sandi akunmu.</p>
    </div>
  </div>

  <!-- SETUP -->
  <div id="screen-setup" class="screen">
    <div class="center-screen" style="padding-top:40px;">
      <span class="note" onclick="showScreen('screen-welcome')" style="align-self:flex-start; cursor:pointer;">&lsaquo; Kembali</span>
      <div class="wordmark logo-big"><span class="groove"></span>Nexus</div>
      <p class="note">Pastikan Redirect URI di bawah sama persis dengan yang kamu daftarkan di Spotify Developer Dashboard.</p>
      <div class="glass" style="width:100%; text-align:left; margin-top:10px; padding:20px; border-radius:18px;">
        <div class="field">
          <label>Client ID</label>
          <input id="inputClientId" placeholder="Client ID Spotify kamu">
        </div>
        <div class="field" style="margin-bottom:0;">
          <label>Redirect URI (harus sama persis dengan dashboard Spotify)</label>
          <input id="inputRedirectUri">
        </div>
      </div>
      <button class="btn" style="margin-top:16px;" onclick="saveSetupAndLogin()">Simpan & Masuk dengan Spotify</button>
      <p class="note">Belum setup Redirect URI? Buka <a href="https://developer.spotify.com/dashboard" target="_blank">developer.spotify.com/dashboard</a> &rsaquo; app kamu &rsaquo; Settings, isi Redirect URI persis seperti kotak di atas.</p>
      <div id="setupError"></div>
    </div>
  </div>

  <!-- LOADING -->
  <div id="screen-loading" class="screen">
    <div class="center-screen"><div class="eq"><i></i><i></i><i></i><i></i></div><p class="note">Menghubungkan ke Spotify…</p></div>
  </div>

  <!-- HOME -->
  <div id="screen-home" class="screen">
    <header class="topbar"><div class="wordmark"><span class="groove"></span>Nexus</div></header>
    <h1 class="greet" id="greetText">Selamat datang</h1>
    <div id="recentGrid" class="grid2"></div>
    <h2 class="section">Jelajahi genre</h2>
    <div class="genre-row">
      <span class="genre-chip" onclick="browseGenre('pop')">Pop</span>
      <span class="genre-chip" onclick="browseGenre('hip-hop')">Hip-Hop</span>
      <span class="genre-chip" onclick="browseGenre('indie')">Indie</span>
      <span class="genre-chip" onclick="browseGenre('chill')">Chill</span>
      <span class="genre-chip" onclick="browseGenre('rock')">Rock</span>
      <span class="genre-chip" onclick="browseGenre('dangdut')">Dangdut</span>
    </div>
    <h2 class="section">Lanjutkan</h2>
    <div id="topTracksRow" class="row-scroll"></div>
    <h2 class="section">Playlist kamu</h2>
    <div id="playlistsRow" class="row-scroll"></div>
  </div>

  <!-- SEARCH -->
  <div id="screen-search" class="screen">
    <header class="topbar"><h2 style="font-weight:600;">Cari</h2></header>
    <input class="search" id="searchInput" placeholder="Lagu, artis, atau album">
    <div class="search-tabs">
      <button class="tab-chip active" id="tabChipTrack" onclick="setSearchType('track', this)">Lagu</button>
      <button class="tab-chip" onclick="setSearchType('artist', this)">Artis</button>
      <button class="tab-chip" onclick="setSearchType('album', this)">Album</button>
      <button class="tab-chip" onclick="setSearchType('playlist', this)">Playlist</button>
    </div>
    <div id="searchResults" style="margin-top:14px;"></div>
  </div>

  <!-- ARTIST -->
  <div id="screen-artist" class="screen">
    <header class="topbar">
      <span class="note" onclick="showScreen('screen-search')" style="cursor:pointer;">&lsaquo; Kembali</span>
    </header>
    <div style="text-align:center; margin-top:10px;">
      <img id="artistImg" src="" style="width:120px;height:120px;border-radius:50%;object-fit:cover;background:#3a2d40;">
      <h1 id="artistName" style="font-size:22px; margin-top:12px;">—</h1>
      <p class="note" id="artistFollowers"></p>
      <button class="btn ghost" id="followBtn" style="width:auto; padding:10px 24px; margin-top:12px;" onclick="toggleFollowArtist()">Ikuti</button>
    </div>
    <h2 class="section">Lagu populer</h2>
    <div id="artistTracks"></div>
  </div>

  <!-- LIBRARY -->
  <div id="screen-library" class="screen">
    <header class="topbar"><h2 style="font-weight:600;">Pustaka</h2></header>
    <h2 class="section">Playlist</h2>
    <div id="libPlaylists"></div>
  </div>
  <div class="fab" id="fabAdd" style="display:none;" onclick="openCreatePlaylistModal()">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="var(--accent-ink)"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z"/></svg>
  </div>

  <!-- PROFILE -->
  <div id="screen-profile" class="screen">
    <header class="topbar"><h2 style="font-weight:600;">Kamu</h2></header>
    <div class="center-screen" style="padding-top:30px;">
      <span class="avatar-ring" id="profileImgWrap" style="display:none;"><img id="profileImg" src="" style="width:84px;height:84px;border-radius:50%;object-fit:cover;background:#3a2d40;"></span>
      <div style="display:flex; align-items:center; gap:7px;">
        <h2 id="profileName">—</h2>
        <svg width="19" height="19" viewBox="0 0 24 24" title="Pemilik akun" style="flex:0 0 auto;">
          <path fill="#3ea6ff" d="M12 2.1l2.3 1.6 2.8-.5 1 2.6 2.5 1.3-.5 2.8L22 12l-1.9 2.1.5 2.8-2.5 1.3-1 2.6-2.8-.5L12 21.9l-2.3-1.6-2.8.5-1-2.6-2.5-1.3.5-2.8L2 12l1.9-2.1-.5-2.8 2.5-1.3 1-2.6 2.8.5z"/>
