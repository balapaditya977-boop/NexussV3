<script>
const SPOTIFY_AUTH = "https://accounts.spotify.com/authorize";
const SPOTIFY_TOKEN = "https://accounts.spotify.com/api/token";
const API = "https://api.spotify.com/v1";
const DEFAULT_CLIENT_ID = "bea8ce466dce445dba7a386f2a3d8085";
const SCOPES = [
  "user-read-private","user-read-email","user-read-currently-playing",
  "user-read-playback-state","user-modify-playback-state",
  "playlist-read-private","playlist-read-collaborative","playlist-modify-private",
  "user-top-read","user-read-recently-played","user-library-read","user-library-modify",
  "user-follow-read","user-follow-modify"
].join(" ");

const LS = {
  clientId:"nexus_client_id", redirectUri:"nexus_redirect_uri", verifier:"nexus_code_verifier",
  accessToken:"nexus_access_token", refreshToken:"nexus_refresh_token", expiresAt:"nexus_expires_at"
};

let currentDeviceId = null, myCountry = "US";

function $(id){ return document.getElementById(id); }
function esc(s){ return (s||"").replace(/[&<>"']/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }

// ---------- PKCE ----------
function randomString(len){
  const chars="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
  let out=""; const arr=new Uint8Array(len); crypto.getRandomValues(arr);
  for(let i=0;i<len;i++) out+=chars[arr[i]%chars.length];
  return out;
}
async function sha256base64url(str){
  const data=new TextEncoder().encode(str);
  const digest=await crypto.subtle.digest("SHA-256", data);
  return btoa(String.fromCharCode(...new Uint8Array(digest))).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
}

function initSetupScreen(){
  $("inputRedirectUri").value = localStorage.getItem(LS.redirectUri) || (location.origin+location.pathname);
  $("inputClientId").value = localStorage.getItem(LS.clientId) || DEFAULT_CLIENT_ID;
}

function goToConnect(){
  if (localStorage.getItem(LS.clientId)){ startSpotifyLogin(); }
  else{ initSetupScreen(); showScreen("screen-setup"); }
}

async function startSpotifyLogin(){
  const clientId = localStorage.getItem(LS.clientId);
  const redirectUri = localStorage.getItem(LS.redirectUri) || (location.origin+location.pathname);
  const verifier = randomString(64);
  localStorage.setItem(LS.verifier, verifier);
  const challenge = await sha256base64url(verifier);
  const state = randomString(16);
  const url = new URL(SPOTIFY_AUTH);
  url.searchParams.set("client_id", clientId);
  url.searchParams.set("response_type","code");
  url.searchParams.set("redirect_uri", redirectUri);
  url.searchParams.set("code_challenge_method","S256");
  url.searchParams.set("code_challenge", challenge);
  url.searchParams.set("scope", SCOPES);
  url.searchParams.set("state", state);
  location.href = url.toString();
}

async function saveSetupAndLogin(){
  const clientId = $("inputClientId").value.trim();
  const redirectUri = $("inputRedirectUri").value.trim();
  if (!clientId){ showSetupError("Client ID wajib diisi."); return; }
  localStorage.setItem(LS.clientId, clientId);
  localStorage.setItem(LS.redirectUri, redirectUri);
  startSpotifyLogin();
}
function showSetupError(msg){ $("setupError").innerHTML = '<div class="error-box">'+msg+'</div>'; }

async function exchangeCodeForToken(code){
  const clientId = localStorage.getItem(LS.clientId);
  const redirectUri = localStorage.getItem(LS.redirectUri);
  const verifier = localStorage.getItem(LS.verifier);
  const body = new URLSearchParams({ client_id:clientId, grant_type:"authorization_code", code, redirect_uri:redirectUri, code_verifier:verifier });
  const res = await fetch(SPOTIFY_TOKEN, { method:"POST", headers:{"Content-Type":"application/x-www-form-urlencoded"}, body });
  if (!res.ok) throw new Error("Gagal menukar kode (cek Client ID & Redirect URI).");
  storeTokens(await res.json());
}
async function refreshAccessToken(){
  const clientId = localStorage.getItem(LS.clientId);
  const refreshToken = localStorage.getItem(LS.refreshToken);
  if (!refreshToken) throw new Error("no refresh token");
  const body = new URLSearchParams({ client_id:clientId, grant_type:"refresh_token", refresh_token:refreshToken });
  const res = await fetch(SPOTIFY_TOKEN, { method:"POST", headers:{"Content-Type":"application/x-www-form-urlencoded"}, body });
  if (!res.ok) throw new Error("refresh failed");
  storeTokens(await res.json(), refreshToken);
}
function storeTokens(data, fallbackRefresh){
  localStorage.setItem(LS.accessToken, data.access_token);
  localStorage.setItem(LS.refreshToken, data.refresh_token || fallbackRefresh || "");
  localStorage.setItem(LS.expiresAt, Date.now() + (data.expires_in*1000) - 10000);
}
async function getValidToken(){
  const expiresAt = parseInt(localStorage.getItem(LS.expiresAt) || "0");
  if (Date.now() > expiresAt) await refreshAccessToken();
  return localStorage.getItem(LS.accessToken);
}

const getCache = new Map();
async function api(path, opts={}, retryCount=0){
  const isGet = !opts.method || opts.method === "GET";
  if (isGet){ const c=getCache.get(path); if (c && Date.now()-c.t<4000) return c.v; }
  const token = await getValidToken();
  const res = await fetch(API+path, { ...opts, headers:{ "Authorization":"Bearer "+token, "Content-Type":"application/json", ...(opts.headers||{}) } });
  if (res.status === 429){
    if (retryCount >= 3) throw new Error("Terlalu banyak permintaan ke Spotify, coba lagi sebentar.");
    const wait = (parseInt(res.headers.get("Retry-After")) || 2) * 1000;
    await new Promise(r=>setTimeout(r, wait));
    return api(path, opts, retryCount+1);
  }
  if (res.status === 204) return null;
  if (!res.ok){ const t = await res.text(); throw new Error("API "+res.status+": "+t); }
  const text = await res.text();
  const data = text ? JSON.parse(text) : null;
  if (isGet) getCache.set(path, { t:Date.now(), v:data });
  return data;
}

function logout(){ Object.values(LS).forEach(k=>localStorage.removeItem(k)); location.href = location.origin+location.pathname; }

function showScreen(id){
  document.querySelectorAll(".screen").forEach(s=>{ s.classList.remove("active"); s.classList.remove("fade-in"); });
  const el = $(id); el.classList.add("active");
  requestAnimationFrame(()=>requestAnimationFrame(()=>el.classList.add("fade-in")));
}
function showTab(name){
  document.querySelectorAll(".tab-btn").forEach(b=>b.classList.toggle("active", b.dataset.tab===name));
  showScreen("screen-"+name);
  $("fabAdd").style.display = name==="library" ? "flex" : "none";
  if (name==="home") loadHome();
  if (name==="library") loadLibrary();
  if (name==="profile") loadProfile();
}

function skeletonTiles(n,w){ return Array(n).fill('<div class="skeleton" style="width:'+w+'px;height:'+w+'px;flex:0 0 auto;"></div>').join(""); }
function showToast(msg){
  let t=$("toastEl");
  if(!t){ t=document.createElement("div"); t.id="toastEl"; t.className="toast"; document.body.appendChild(t); }
  t.textContent=msg; t.classList.add("show");
  clearTimeout(t._timer); t._timer=setTimeout(()=>t.classList.remove("show"), 3200);
}

async function loadHome(){
  $("topTracksRow").innerHTML = skeletonTiles(5,128);
  $("playlistsRow").innerHTML = skeletonTiles(5,128);
  try{
    const me = await api("/me");
    myCountry = me.country || "US";
    const hour = new Date().getHours();
    $("greetText").textContent = hour<11?"Selamat pagi":hour<15?"Selamat siang":hour<19?"Selamat sore":"Selamat malam";

    const recent = await api("/me/player/recently-played?limit=6");
    if (!recent.items || !recent.items.length){
      $("recentGrid").innerHTML = '<div class="empty-state" style="grid-column:1/-1;">Belum ada riwayat putar.</div>';
    } else {
      $("recentGrid").innerHTML = recent.items.map((it,i)=>{
        const t=it.track; const img=(t.album.images[2]||t.album.images[0]||{}).url||"";
        return '<div class="pillcard pop-in" style="animation-delay:'+(i*40)+'ms" onclick="playUri(\''+t.uri+'\')"><img src="'+img+'"><span>'+esc(t.name)+'</span></div>';
      }).join("");
    }

    const top = await api("/me/top/tracks?limit=10&time_range=short_term");
    $("topTracksRow").innerHTML = (top.items||[]).map((t,i)=>{
      const img=(t.album.images[1]||t.album.images[0]||{}).url||"";
      return '<div class="tile pop-in" style="animation-delay:'+(i*35)+'ms" onclick="playUri(\''+t.uri+'\')"><img src="'+img+'">'+heartSvg(false,t.id)+'<p>'+esc(t.name)+'</p><p class="sub">'+esc(t.artists[0].name)+'</p></div>';
    }).join("");
    syncHearts("#topTracksRow .heart", (top.items||[]).map(t=>t.id));

    const pls = await api("/me/playlists?limit=10");
    $("playlistsRow").innerHTML = (pls.items||[]).map((p,i)=>{
      const img=(p.images[0]||{}).url||"";
      return '<div class="tile pop-in" style="animation-delay:'+(i*35)+'ms" onclick="openPlaylist(\''+p.id+'\')"><img src="'+img+'"><p>'+esc(p.name)+'</p><p class="sub">'+p.tracks.total+' lagu</p></div>';
    }).join("");

    pollCurrentlyPlaying();
  }catch(e){ console.error(e); showToast(e.message||"Gagal memuat beranda."); }
}

async function loadLibrary(){
  $("libPlaylists").innerHTML = '<div class="skeleton" style="height:58px;margin-bottom:10px;"></div>'.repeat(5);
  try{
    const pls = await api("/me/playlists?limit=50");
    if (!pls.items || !pls.items.length){
      $("libPlaylists").innerHTML = '<div class="empty-state">Belum ada playlist di akunmu. Tap tombol + untuk buat baru.</div>';
      return;
    }
    $("libPlaylists").innerHTML = pls.items.map((p,i)=>{
      const img=(p.images[0]||{}).url||"";
      return '<div class="list-item pop-in" style="animation-delay:'+(i*30)+'ms" onclick="openPlaylist(\''+p.id+'\')"><img src="'+img+'"><div class="meta"><b>'+esc(p.name)+'</b><span>'+p.tracks.total+' lagu, dibuat oleh '+esc(p.owner.display_name||"kamu")+'</span></div></div>';
    }).join("");
  }catch(e){ console.error(e); showToast(e.message||"Gagal memuat pustaka."); }
}

async function loadProfile(){
  try{
    const me = await api("/me");
    $("profileName").textContent = me.display_name || me.id;
    $("profileEmail").textContent = me.email || "";
    if (me.images && me.images[0]){ $("profileImg").src = me.images[0].url; $("profileImgWrap").style.display="inline-flex"; }
  }catch(e){ console.error(e); }
}

async function openPlaylist(id){
  $("searchResults").innerHTML = '<div class="skeleton" style="height:58px;margin-bottom:10px;"></div>'.repeat(6);
  showScreen("screen-search");
  document.querySelectorAll(".tab-btn").forEach(b=>b.classList.toggle("active", b.dataset.tab==="search"));
  try{
    const data = await api("/playlists/"+id+"/tracks?limit=50");
    const items = (data.items||[]).filter(it=>it.track);
    if (!items.length){ $("searchResults").innerHTML = '<div class="empty-state">Playlist ini masih kosong.</div>'; return; }
    $("searchResults").innerHTML = '<h2 class="section">Playlist</h2>' + items.map((it,i)=>{
      const t=it.track; const img=(t.album.images[2]||t.album.images[0]||{}).url||"";
      return '<div class="list-item pop-in" style="animation-delay:'+(i*25)+'ms" onclick="playUri(\''+t.uri+'\')"><img src="'+img+'"><div class="meta"><b>'+esc(t.name)+'</b><span>'+esc((t.artists||[]).map(a=>a.name).join(", "))+'</span></div></div>';
    }).join("");
  }catch(e){ showToast(e.message||"Gagal memuat playlist."); }
}

let searchDebounce, currentSearchType="track";
$("searchInput")?.addEventListener("input",(e)=>{
  clearTimeout(searchDebounce);
  const q=e.target.value.trim();
  if(!q){ $("searchResults").innerHTML=""; return; }
  searchDebounce=setTimeout(()=>doSearch(q),400);
});
function setSearchType(type, btn){
  currentSearchType=type;
  document.querySelectorAll(".tab-chip").forEach(b=>b.classList.remove("active"));
  btn.classList.add("active");
  const q=$("searchInput").value.trim();
  if(q) doSearch(q);
}
function browseGenre(g){
  showTab("search");
  setTimeout(()=>{
    document.querySelectorAll(".tab-chip").forEach(b=>b.classList.remove("active"));
    $("tabChipTrack").classList.add("active");
    currentSearchType="track";
    $("searchInput").value = g;
    doSearch('genre:"'+g+'"');
  }, 60);
}

async function doSearch(q){
  $("searchResults").innerHTML = '<div class="skeleton" style="height:58px;margin-bottom:10px;"></div>'.repeat(6);
  try{
    const data = await api("/search?q="+encodeURIComponent(q)+"&type="+currentSearchType+"&limit=20");
    const key = currentSearchType+"s";
    if (!data[key] || !data[key].items || !data[key].items.length){
      $("searchResults").innerHTML = '<div class="empty-state">Tidak ada hasil untuk "'+esc(q)+'".</div>';
      return;
    }
    if (currentSearchType==="track"){
      const tracks=data.tracks.items;
      $("searchResults").innerHTML = tracks.map((t,i)=>{
        const img=(t.album.images[2]||t.album.images[0]||{}).url||"";
        return '<div class="list-item pop-in" style="animation-delay:'+(i*25)+'ms" onclick="playUri(\''+t.uri+'\')"><img src="'+img+'"><div class="meta"><b>'+esc(t.name)+'</b><span>'+esc(t.artists.map(a=>a.name).join(", "))+'</span></div>'+heartSvg(false,t.id)+'</div>';
      }).join("");
      syncHearts("#searchResults .heart", tracks.map(t=>t.id));
    } else if (currentSearchType==="artist"){
      $("searchResults").innerHTML = data.artists.items.map((a,i)=>{
        const img=(a.images[1]||a.images[0]||{}).url||"";
        return '<div class="list-item pop-in" style="animation-delay:'+(i*25)+'ms" onclick="openArtist(\''+a.id+'\')"><img src="'+img+'" style="border-radius:50%;"><div class="meta"><b>'+esc(a.name)+'</b><span>Artis</span></div></div>';
      }).join("");
    } else if (currentSearchType==="album"){
      $("searchResults").innerHTML = data.albums.items.map((al,i)=>{
        const img=(al.images[1]||al.images[0]||{}).url||"";
        return '<div class="list-item pop-in" style="animation-delay:'+(i*25)+'ms"><img src="'+img+'"><div class="meta"><b>'+esc(al.name)+'</b><span>'+esc(al.artists.map(a=>a.name).join(", "))+'</span></div></div>';
      }).join("");
    } else if (currentSearchType==="playlist"){
      $("searchResults").innerHTML = data.playlists.items.filter(Boolean).map((p,i)=>{
        const img=(p.images&&p.images[0]||{}).url||"";
        return '<div class="list-item pop-in" style="animation-delay:'+(i*25)+'ms" onclick="openPlaylist(\''+p.id+'\')"><img src="'+img+'"><div class="meta"><b>'+esc(p.name)+'</b><span>'+p.tracks.total+' lagu</span></div></div>';
      }).join("");
    }
  }catch(e){ console.error(e); showToast(e.message||"Pencarian gagal."); }
}

