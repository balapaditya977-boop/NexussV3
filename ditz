    $("artistFollowers").textContent = (a.followers.total||0).toLocaleString("id-ID")+" pengikut";
    const top = await api("/artists/"+id+"/top-tracks?market="+myCountry);
    $("artistTracks").innerHTML = (top.tracks||[]).slice(0,10).map((t,i)=>{
      const img=(t.album.images[2]||t.album.images[0]||{}).url||"";
